{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>thegeeklab/renovate-presets:golang"],
  "customManagers": [
    {
      "description": "Track the kindest/node image in hack/kind.yaml",
      "customType": "regex",
      "managerFilePatterns": ["/^hack/kind\\.yaml$/"],
      "matchStrings": ["image: kindest/node:(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "kindest/node"
    }
  ],
  "packageRules": [
    {
      "groupName": "kubernetes packages",
      "matchDatasources": ["go", "docker"],
      "matchDepNames": ["/^k8s\\.io\\//", "sigs.k8s.io/controller-runtime", "kindest/node"]
    },
    {
      "groupName": "opentelemetry packages",
      "matchDatasources": ["go"],
      "matchPackageNames": ["/^go\\.opentelemetry\\.io\\//"]
    },
    {
      "groupName": "golang.org/x packages",
      "matchDatasources": ["go"],
      "matchPackageNames": ["/^golang\\.org/x\\//"]
    },
    {
      "groupName": "git platform SDKs",
      "matchDatasources": ["go"],
      "matchPackageNames": [
        "code.gitea.io/sdk/gitea",
        "/^github\\.com/google/go-github\\//",
        "/^gitlab\\.com/gitlab-org/api/client-go\\//"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "extends": ["schedule:weekly"]
    },
    {
      "groupName": "golangci-lint",
      "matchDatasources": ["docker", "github-releases"],
      "matchPackageNames": ["golangci/golangci-lint"]
    }
  ]
}
