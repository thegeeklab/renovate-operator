package view

import (
	"fmt"

	"github.com/thegeeklab/renovate-operator/internal/frontend/sanitize"
	"github.com/thegeeklab/renovate-operator/internal/frontend/viewmodel"
)

templ RenovatorCountBadge(namespace, renovatorUID string, count int) {
	<span
		hx-get={ sanitize.RenovatorCountURL(namespace, renovatorUID) }
		hx-trigger="sse:job-updated"
		hx-swap="outerHTML"
		hx-target="this"
		class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10"
	>
		{ count }
	</span>
}

// RenovatorPRBadge renders the open-PR count for a Renovator as a small
// pill that auto-refreshes via SSE.
templ RenovatorPRBadge(namespace, renovatorUID string, open, needsApproval, unchanged int, hasRecentData bool) {
	if !hasRecentData || (open == 0 && needsApproval == 0) {
		@Tooltip(getPRBadgeTooltip(hasRecentData, open, needsApproval, unchanged)) {
			<span
				hx-get={ sanitize.RenovatorPRsURL(namespace, renovatorUID) }
				hx-trigger="sse:job-updated throttle:15s"
				hx-swap="outerHTML"
				hx-target="this"
				class="inline-flex items-center gap-1 rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-500 ring-1 ring-inset ring-gray-500/20"
			>
				@IconArrowPath("h-3.5 w-3.5")
				if hasRecentData {
					0
				} else {
					—
				}
			</span>
		}
	} else if needsApproval > 0 {
		@Tooltip(getPRBadgeTooltip(hasRecentData, open, needsApproval, unchanged)) {
			<span
				hx-get={ sanitize.RenovatorPRsURL(namespace, renovatorUID) }
				hx-trigger="sse:job-updated throttle:15s"
				hx-swap="outerHTML"
				hx-target="this"
				class="inline-flex items-center gap-1.5 rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/20"
			>
				@IconExclamationTriangle("h-3.5 w-3.5")
				{ needsApproval }
				if open > 0 {
					<span class="inline-flex items-center rounded bg-red-100 px-1 text-red-700">+{ open }</span>
				}
			</span>
		}
	} else if unchanged > 0 && open == unchanged {
		@Tooltip(getPRBadgeTooltip(hasRecentData, open, needsApproval, unchanged)) {
			<span
				hx-get={ sanitize.RenovatorPRsURL(namespace, renovatorUID) }
				hx-trigger="sse:job-updated throttle:15s"
				hx-swap="outerHTML"
				hx-target="this"
				class="inline-flex items-center gap-1 rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-500 ring-1 ring-inset ring-gray-500/20"
			>
				@IconInformationCircle("h-3.5 w-3.5")
				{ open }
			</span>
		}
	} else {
		@Tooltip(getPRBadgeTooltip(hasRecentData, open, needsApproval, unchanged)) {
			<span
				hx-get={ sanitize.RenovatorPRsURL(namespace, renovatorUID) }
				hx-trigger="sse:job-updated throttle:15s"
				hx-swap="outerHTML"
				hx-target="this"
				class="inline-flex items-center gap-1 rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-600/20"
			>
				@IconArrowPath("h-3.5 w-3.5")
				{ open }
			</span>
		}
	}
}

templ RenovatorList(data viewmodel.DashboardData) {
	<div class="bg-white shadow-sm mb-6 shrink-0">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
			<h2 class="hidden sm:block text-2xl font-bold tracking-tight text-gray-900" data-focus-target>Dashboard</h2>
			<div class="relative w-full sm:w-64">
				<input
					type="search"
					name="search"
					value={ data.SearchQuery }
					autocomplete="off"
					placeholder="Search all repositories..."
					aria-label="Search all repositories"
					hx-get="/"
					hx-push-url="true"
					hx-target="#dashboard-content"
					hx-swap="innerHTML"
					hx-trigger="input changed delay:500ms, search"
					class="block w-full rounded-md border-0 py-2 pl-3 pr-16 text-sm text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400"
				/>
				if data.SearchQuery == "" {
					<div class="absolute inset-y-0 right-0 flex items-center gap-1 pr-2 pointer-events-none">
						@Kbd("/")
						@IconMagnifyingGlass("h-4 w-4 text-gray-400")
					</div>
				} else {
					<button
						type="button"
						hx-get="/"
						hx-push-url="true"
						hx-target="#dashboard-content"
						hx-swap="innerHTML"
						aria-label="Clear search"
						class="absolute inset-y-0 right-0 flex items-center pr-2 text-gray-400 hover:text-gray-600 cursor-pointer"
					>
						@IconXMark("h-4 w-4")
					</button>
				}
			</div>
		</div>
	</div>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-12">
		if data.SearchQuery != "" {
			if len(data.SearchResults) > 0 {
				@GitRepoList(data.SearchResults)
			} else {
				@EmptyState("No Results Found", "No repositories match your search query.")
			}
		} else if len(data.Renovators) == 0 {
			@EmptyState("No Renovators Found", "Get started by creating a Renovator custom resource.")
		} else {
			<div class="space-y-4">
				for _, v := range data.Renovators {
					@RenovatorCard(v)
				}
			</div>
		}
	</div>
}

templ RenovatorCard(v viewmodel.WebView) {
	<details
		data-cloak
		data-component="renovator-details"
		data-persist-key={ sanitize.RenovatorPersistKey(v.Name) }
		class="group bg-white shadow-sm rounded-lg overflow-hidden border border-gray-200"
	>
		<summary class="cursor-pointer bg-white px-4 py-5 sm:p-6 hover:bg-gray-50 transition-colors">
			<div class="flex items-center justify-between">
				<div class="flex items-center gap-4">
					@IconChevronRight("chevron h-5 w-5 text-gray-400")
					<div>
						<h3 class="text-base font-semibold leading-6 text-gray-900">
							{ v.Name }
						</h3>
						<p class="mt-1 max-w-2xl text-sm text-gray-500">
							Namespace:
							<span class="font-medium text-gray-900">{ v.Namespace }</span>
						</p>
					</div>
				</div>
				<div class="flex items-center gap-2 sm:gap-6">
					<div class="flex flex-col items-end sm:items-center justify-center gap-1">
						<span class="text-xs text-gray-500">Repos</span>
						@RenovatorCountBadge(v.Namespace, v.Renovator, v.GitRepoCount)
					</div>
					<div class="flex flex-col items-end sm:items-center justify-center gap-1">
						<span class="text-xs text-gray-500">PRs</span>
						@RenovatorPRBadge(v.Namespace, v.Renovator, v.OpenPRs, v.NeedsApproval, v.UnchangedPRs, v.HasRecentPR)
					</div>
					<div class="hidden sm:flex flex-col items-end justify-center gap-1">
						<span class="text-xs text-gray-500">Runner</span>
						<span class="text-sm font-medium text-gray-900">{ v.RunnerName }</span>
					</div>
					<div class="hidden sm:flex flex-col items-end justify-center gap-1">
						<span class="text-xs text-gray-500">Discovery</span>
						<span class="text-sm font-medium text-gray-900">{ v.DiscoveryName }</span>
					</div>
				</div>
			</div>
		</summary>
		<div class="details-content">
			<div class="details-content-inner">
				<div
					class="border-t border-gray-200 bg-gray-50 px-4 py-5 sm:p-6"
					data-component="repo-sort"
					data-sort-key={ sanitize.SortFieldPersistKey(v.Name) }
					data-order-key={ sanitize.SortOrderPersistKey(v.Name) }
				>
					@RepoSortControls(v.Name)
					<div
						data-ref="repoList"
						hx-get={ sanitize.GitreposURL(v.Namespace, v.Renovator) }
						hx-trigger="revealed once, sse:job-updated, sort-changed"
						hx-swap="innerHTML"
						class="focus:outline-none"
					>
						@SkeletonRepoList()
					</div>
				</div>
			</div>
		</div>
	</details>
}

templ RepoSortControls(renovatorName string) {
	<div class="flex items-center justify-end mb-4 gap-2">
		<label for={ "sort-" + renovatorName } class="sr-only">Sort repositories</label>
		<div class="relative">
			<button
				type="button"
				data-action="toggle-sort"
				aria-expanded="false"
				aria-haspopup="listbox"
				class="inline-flex items-center gap-1 rounded-md p-2 text-xs font-medium text-gray-700 ring-1 ring-inset ring-gray-300 bg-white hover:bg-gray-50 cursor-pointer transition-colors"
			>
				<span data-role="sort-label">{ string(viewmodel.GitRepoFieldName) }</span>
				@IconChevronUpDown("h-4 w-4 text-gray-500")
			</button>
			<div
				data-role="sort-menu"
				class={ dropdownMenu() + " bg-white" }
				role="listbox"
			>
				<div class="px-1">
					<button type="button" data-value="name" data-role="sort-option" role="option" class={ dropdownMenuItem() + " text-gray-700 hover:bg-gray-100 rounded-md" }>
						{ string(viewmodel.GitRepoFieldName) }
					</button>
					<button type="button" data-value="date" data-role="sort-option" role="option" class={ dropdownMenuItem() + " text-gray-700 hover:bg-gray-100 rounded-md" }>
						{ string(viewmodel.GitRepoFieldCreated) }
					</button>
					<button type="button" data-value="last_update" data-role="sort-option" role="option" class={ dropdownMenuItem() + " text-gray-700 hover:bg-gray-100 rounded-md" }>
						{ string(viewmodel.GitRepoFieldLastRun) }
					</button>
				</div>
			</div>
		</div>
		@Tooltip("Sort ascending", "sort-order") {
			<button
				type="button"
				data-cloak
				data-action="toggle-order"
				aria-pressed="false"
				class="inline-flex items-center justify-center rounded-md p-2 text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-100 bg-white cursor-pointer transition-colors"
			>
				<span data-role="sort-asc">
					@IconBarsArrowDown("h-4 w-4")
				</span>
				<span data-role="sort-desc" class="hidden">
					@IconBarsArrowUp("h-4 w-4")
				</span>
			</button>
		}
	</div>
}

// getPRBadgeTooltip returns the human-readable explanation for a
// RenovatorPRBadge pill, derived from the same inputs the templ uses to
// pick its tint and content.
func getPRBadgeTooltip(hasRecentData bool, open, needsApproval, unchanged int) string {
	if !hasRecentData {
		return "No recent Renovate data (no completed jobs or pod logs GC'd)"
	}

	active := open - unchanged

	if needsApproval > 0 {
		if active > 0 {
			return fmt.Sprintf("%d PRs need approval, %d additional active", needsApproval, active)
		}

		return fmt.Sprintf("%d PRs need approval", needsApproval)
	}

	if active == 0 && unchanged > 0 {
		return fmt.Sprintf("%d Unchanged PRs (no updates needed)", unchanged)
	}

	if open == 0 {
		return "No open PRs"
	}

	if open == 1 {
		return "1 open PR"
	}

	return fmt.Sprintf("%d open PRs", open)
}
