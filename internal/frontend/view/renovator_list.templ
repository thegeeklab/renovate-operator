package view

import (
	"context"

	"github.com/thegeeklab/renovate-operator/internal/frontend/i18n"
	"github.com/thegeeklab/renovate-operator/internal/frontend/sanitize"
	"github.com/thegeeklab/renovate-operator/internal/frontend/viewmodel"
)

templ RenovatorCountBadge(namespace, renovatorUID string, count int) {
	<span
		hx-get={ sanitize.RenovatorCountURL(namespace, renovatorUID) }
		hx-trigger="sse:job-updated"
		hx-swap="outerHTML"
		hx-target="this"
		class="inline-flex items-center rounded-md bg-indigo-50 dark:bg-indigo-950 px-2 py-1 text-xs font-medium text-indigo-700 dark:text-indigo-400 ring-1 ring-inset ring-indigo-700/10 dark:ring-indigo-500/20"
	>
		{ count }
	</span>
}

// RenovatorPRBadge renders the open-PR count for a Renovator as a small
// pill that auto-refreshes via SSE. Colors match the log viewer: yellow
// when PRs need approval, gray when all PRs are unchanged, blue otherwise.
templ RenovatorPRBadge(ctx context.Context, namespace, renovatorUID string, open, needsApproval, unchanged int, hasRecentData bool) {
	@Tooltip(getPRBadgeTooltip(ctx, hasRecentData, open, needsApproval, unchanged)) {
		<span
			hx-get={ sanitize.RenovatorPRsURL(namespace, renovatorUID) }
			hx-trigger="sse:job-updated throttle:15s"
			hx-swap="outerHTML"
			hx-target="this"
			class={ "inline-flex items-center gap-1 rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset " + getPRBadgeColorClasses(open, needsApproval, unchanged) }
		>
			@IconGitPullRequest("h-3.5 w-3.5")
			if !hasRecentData {
				—
			} else {
				{ open }
			}
		</span>
	}
}

// RenovatorWarningsBadge renders a warning/error count badge for a Renovator
// that auto-refreshes via SSE. Always renders a target element (hidden when
// no warnings) so HTMX has a DOM anchor for SSE-triggered refreshes.
templ RenovatorWarningsBadge(ctx context.Context, namespace, renovatorUID string, warnCount, errorCount int) {
	if warnCount == 0 && errorCount == 0 {
		<span
			hx-get={ sanitize.RenovatorWarningsURL(namespace, renovatorUID) }
			hx-trigger="sse:job-updated throttle:15s"
			hx-swap="outerHTML"
			hx-target="this"
			class="hidden"
			aria-hidden="true"
		></span>
	} else {
		@Tooltip(getWarningsBadgeTooltip(ctx, warnCount, errorCount)) {
			<span
				hx-get={ sanitize.RenovatorWarningsURL(namespace, renovatorUID) }
				hx-trigger="sse:job-updated throttle:15s"
				hx-swap="outerHTML"
				hx-target="this"
				class={ "inline-flex items-center gap-1 rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset " + getWarningBadgeColorClasses(errorCount) }
			>
				@IconTriangleAlert("h-3.5 w-3.5")
				@WarningCountDisplay(warnCount, errorCount)
			</span>
		}
	}
}

templ searchBar(ctx context.Context, data viewmodel.DashboardData) {
	@SearchBarContent(ctx, data)
}

templ SearchBarContent(ctx context.Context, data viewmodel.DashboardData) {
	<div class="relative flex-1 min-w-0">
		<input
			type="search"
			name="search"
			value={ data.SearchQuery }
			autocomplete="off"
			placeholder={ i18n.FromContext(ctx).T("dashboard.search_placeholder") }
			aria-label={ i18n.FromContext(ctx).T("dashboard.search_aria_label") }
			hx-get="/"
			hx-push-url="true"
			hx-target="#dashboard-content"
			hx-swap="innerHTML"
			hx-trigger="input changed delay:500ms, search"
			class="block w-full rounded-md border-0 py-2 pl-3 pr-16 text-sm text-gray-900 dark:text-gray-100 ring-1 ring-inset ring-gray-300 dark:ring-gray-600 placeholder:text-gray-400 dark:placeholder:text-gray-500 bg-white dark:bg-gray-900"
		/>
		if data.SearchQuery == "" {
			<div class="absolute inset-y-0 right-0 flex items-center gap-1 pr-2 pointer-events-none">
				@Kbd("/")
				@IconSearch("h-4 w-4 text-gray-400 dark:text-gray-500")
			</div>
		} else {
			<button
				type="button"
				hx-get="/"
				hx-push-url="true"
				hx-target="#dashboard-content"
				hx-swap="innerHTML"
				aria-label={ i18n.FromContext(ctx).T("common.clear_search") }
				class="absolute inset-y-0 right-0 flex items-center pr-2 text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 cursor-pointer"
			>
				@IconX("h-4 w-4")
			</button>
		}
	</div>
}

templ RenovatorList(ctx context.Context, data viewmodel.DashboardData) {
	<div class="bg-white dark:bg-gray-800 shadow-sm shrink-0">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-20 flex items-center">
			<h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-gray-100" data-focus-target>{ i18n.FromContext(ctx).T("dashboard.title") }</h2>
		</div>
	</div>
	<div data-kb-nav-scope="dashboard" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
		if data.SearchQuery != "" {
			<div class="flex items-center gap-6 mb-6">
				@searchBar(ctx, data)
			</div>
			if len(data.SearchResults) > 0 {
				@GitRepoList(ctx, data.SearchResults)
			} else {
				@EmptyState(i18n.FromContext(ctx).T("dashboard.no_results_title"), i18n.FromContext(ctx).T("dashboard.no_results_message"))
			}
		} else if len(data.Renovators) == 0 {
			<div class="flex items-center gap-6 mb-6">
				@searchBar(ctx, data)
			</div>
			@EmptyState(i18n.FromContext(ctx).T("dashboard.no_renovators_title"), i18n.FromContext(ctx).T("dashboard.no_renovators_message"))
		} else {
			<div class="flex items-center gap-6 mb-6">
				@searchBar(ctx, data)
				<button
					type="button"
					data-component="collapse-toggle"
					class="inline-flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 ring-1 ring-inset ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors cursor-pointer shrink-0"
				>
					<span data-collapse-icon>
						@IconFoldVertical("h-4 w-4")
					</span>
					<span data-expand-icon class="hidden">
						@IconUnfoldVertical("h-4 w-4")
					</span>
					<span class="hidden sm:inline">{ i18n.FromContext(ctx).T("dashboard.toggle_all") }</span>
				</button>
			</div>
			<div class="space-y-4">
				for _, v := range data.Renovators {
					@RenovatorCard(ctx, v)
				}
			</div>
		}
	</div>
}

templ RenovatorCard(ctx context.Context, v viewmodel.WebView) {
	<details
		data-cloak
		data-component="renovator-details"
		data-persist-key={ sanitize.RenovatorPersistKey(v.Name) }
		class="group bg-white dark:bg-gray-800 shadow-sm rounded-lg overflow-hidden border border-gray-200 dark:border-gray-700"
	>
		<summary data-kb-nav tabindex="0" class="cursor-pointer bg-white dark:bg-gray-800 px-4 py-5 sm:p-6 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-indigo-500">
			<div class="flex items-center justify-between">
				<div class="flex items-center gap-4">
					@IconChevronRight("chevron h-5 w-5 text-gray-400 dark:text-gray-500")
					<div>
						<h3 class="text-base font-semibold leading-6 text-gray-900 dark:text-gray-100">
							{ v.Name }
						</h3>
						<p class="mt-1 max-w-2xl text-sm text-gray-500 dark:text-gray-400">
							{ i18n.FromContext(ctx).T("common.namespace") }:
							<span class="font-medium text-gray-900 dark:text-gray-100">{ v.Namespace }</span>
						</p>
					</div>
				</div>
				<div class="flex items-center gap-2 sm:gap-6">
					<div class="flex flex-col items-end sm:items-center justify-center gap-1">
						<span class="text-xs text-gray-500 dark:text-gray-400">{ i18n.FromContext(ctx).T("common.repos") }</span>
						@RenovatorCountBadge(v.Namespace, v.Renovator, v.GitRepoCount)
					</div>
					<div class="flex flex-col items-end sm:items-center justify-center gap-1">
						<span class="text-xs text-gray-500 dark:text-gray-400">{ i18n.FromContext(ctx).T("common.prs") }</span>
						@RenovatorPRBadge(ctx, v.Namespace, v.Renovator, v.OpenPRs, v.NeedsApproval, v.UnchangedPRs, v.HasRecentPR)
					</div>
					<div class="flex flex-col items-end sm:items-center justify-center gap-1">
						<span class="text-xs text-gray-500 dark:text-gray-400">{ i18n.FromContext(ctx).T("common.warnings") }</span>
						@RenovatorWarningsBadge(ctx, v.Namespace, v.Renovator, v.WarnCount, v.ErrorCount)
					</div>
					<div class="hidden sm:flex flex-col items-end justify-center gap-1">
						<span class="text-xs text-gray-500 dark:text-gray-400">{ i18n.FromContext(ctx).T("common.runner") }</span>
						<span class="text-sm font-medium text-gray-900 dark:text-gray-100">{ v.RunnerName }</span>
					</div>
					<div class="hidden sm:flex flex-col items-end justify-center gap-1">
						<span class="text-xs text-gray-500 dark:text-gray-400">{ i18n.FromContext(ctx).T("common.discovery") }</span>
						<span class="text-sm font-medium text-gray-900 dark:text-gray-100">{ v.DiscoveryName }</span>
					</div>
				</div>
			</div>
		</summary>
		<div class="details-content">
			<div class="details-content-inner">
				<div
					class="border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 px-4 py-5 sm:p-6"
					data-component="repo-sort"
					data-sort-key={ sanitize.SortFieldPersistKey(v.Name) }
					data-order-key={ sanitize.SortOrderPersistKey(v.Name) }
					data-filter-key={ sanitize.FilterPersistKey(v.Name) }
				>
					@RepoSortControls(ctx, v.Name)
					<div
						data-ref="repoList"
						hx-get={ sanitize.GitreposURL(v.Namespace, v.Renovator) }
						hx-trigger="revealed once, sse:job-updated, list-changed"
						hx-swap="innerHTML"
						class="focus:outline-none"
					>
						@SkeletonRepoList()
					</div>
				</div>
			</div>
		</div>
	</details>
}

templ RepoSortControls(ctx context.Context, renovatorName string) {
	<div class="flex items-center justify-end mb-4 gap-6">
		<div data-component="repo-filter" class="relative">
			<button
				type="button"
				data-cloak
				data-action="toggle-filter"
				aria-expanded="false"
				aria-haspopup="listbox"
				class="inline-flex items-center gap-1 rounded-md p-2 text-xs font-medium text-gray-700 dark:text-gray-300 ring-1 ring-inset ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer transition-colors"
			>
				@IconFunnel("h-4 w-4")
				<span class="hidden sm:inline">{ i18n.FromContext(ctx).T("common.filter") }</span>
			</button>
			<div
				data-role="filter-menu"
				class={ dropdownMenu() + " bg-white dark:bg-gray-800" }
				role="listbox"
				aria-multiselectable="true"
			>
				<div class="px-1">
					<label class={ dropdownMenuItem() + " text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-md" }>
						<input type="checkbox" data-filter={ string(viewmodel.GitRepoFilterOpenPRs) } class="custom-checkbox"/>
						<span>{ i18n.FromContext(ctx).T("filter.open_prs") }</span>
					</label>
					<label class={ dropdownMenuItem() + " text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-md" }>
						<input type="checkbox" data-filter={ string(viewmodel.GitRepoFilterWarnings) } class="custom-checkbox"/>
						<span>{ i18n.FromContext(ctx).T("filter.warnings") }</span>
					</label>
					<label class={ dropdownMenuItem() + " text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-md" }>
						<input type="checkbox" data-filter={ string(viewmodel.GitRepoFilterErrors) } class="custom-checkbox"/>
						<span>{ i18n.FromContext(ctx).T("filter.errors") }</span>
					</label>
				</div>
			</div>
		</div>
		<div class="flex items-center gap-2">
			<label for={ "sort-" + renovatorName } class="sr-only">{ i18n.FromContext(ctx).T("sort.sort_repositories") }</label>
			<div class="relative">
				<button
					type="button"
					data-action="toggle-sort"
					aria-expanded="false"
					aria-haspopup="listbox"
					class="inline-flex items-center gap-1 rounded-md p-2 text-xs font-medium text-gray-700 dark:text-gray-300 ring-1 ring-inset ring-gray-300 dark:ring-gray-600 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer transition-colors"
				>
					<span data-role="sort-label">{ viewmodel.GitRepoFieldName.TranslatedLabel(ctx) }</span>
					@IconChevronsUpDown("h-4 w-4 text-gray-500 dark:text-gray-400")
				</button>
				<div
					data-role="sort-menu"
					class={ dropdownMenu() + " bg-white dark:bg-gray-800" }
					role="listbox"
				>
					<div class="px-1">
						<button type="button" data-value="name" data-role="sort-option" role="option" class={ dropdownMenuItem() + " text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-md" }>
							{ viewmodel.GitRepoFieldName.TranslatedLabel(ctx) }
						</button>
						<button type="button" data-value="date" data-role="sort-option" role="option" class={ dropdownMenuItem() + " text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-md" }>
							{ viewmodel.GitRepoFieldCreated.TranslatedLabel(ctx) }
						</button>
						<button type="button" data-value="last_update" data-role="sort-option" role="option" class={ dropdownMenuItem() + " text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-md" }>
							{ viewmodel.GitRepoFieldLastRun.TranslatedLabel(ctx) }
						</button>
					</div>
				</div>
			</div>
			@Tooltip(i18n.FromContext(ctx).T("sort.sort_ascending"), "sort-order") {
				<button
					type="button"
					data-cloak
					data-action="toggle-order"
					aria-pressed="false"
					class="inline-flex items-center justify-center rounded-md p-2 text-gray-700 dark:text-gray-300 ring-1 ring-inset ring-gray-300 dark:ring-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 bg-white dark:bg-gray-800 cursor-pointer transition-colors"
				>
					<span data-role="sort-asc">
						@IconArrowDownWideNarrow("h-4 w-4")
					</span>
					<span data-role="sort-desc" class="hidden">
						@IconArrowUpNarrowWide("h-4 w-4")
					</span>
				</button>
			}
		</div>
	</div>
}
