package view

templ EmptyState(title, message string, extraClass ...string) {
	<div class={ emptyStateClass(extraClass) }>
		@IconInbox("mx-auto h-12 w-12 text-gray-400")
		<h3 class="mt-2 text-sm font-semibold text-gray-900">{ title }</h3>
		<p class="mt-1 text-sm text-gray-500">
			{ message }
		</p>
	</div>
}

func emptyStateClass(extra []string) string {
	if len(extra) == 0 || extra[0] == "" {
		return "text-center py-12"
	}

	return "text-center py-12 " + extra[0]
}
