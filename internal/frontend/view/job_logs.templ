// cspell:ignore tabular-nums strconv Itoa
package view

import "strconv"

import "github.com/thegeeklab/renovate-operator/internal/frontend/sanitize"
import "github.com/thegeeklab/renovate-operator/internal/frontend/viewmodel"
import "github.com/thegeeklab/renovate-operator/internal/parser"

type levelOption struct {
	Value int
	Label string
	Class string
}

func logLevelOptions() []levelOption {
	return []levelOption{
		{10, "TRACE", "text-gray-500"},
		{20, "DEBUG", "text-purple-400"},
		{30, "INFO", "text-white"},
		{40, "WARN", "text-yellow-400"},
		{50, "ERROR", "text-red-500"},
		{60, "FATAL", "text-red-300"},
	}
}

templ JobLogs(data viewmodel.JobLogData) {
	<div
		id={ "logs-" + data.JobName }
		data-cloak
		data-component="log-viewer"
		data-namespace={ data.Namespace }
		data-runner={ data.Runner }
		data-job-name={ data.JobName }
		data-is-running={ sanitize.BoolAttr(data.IsRunning) }
		class="rounded-lg bg-gray-900 shadow-lg overflow-hidden flex flex-col border border-gray-700 w-full h-full"
		if data.IsRunning {
			hx-get={ sanitize.JobLogsURL(data.Namespace, data.Runner, data.JobName, data.Platform, data.RepoURL, false) }
			hx-trigger="every 2s"
			hx-swap="outerHTML show:no-scroll"
		}
	>
		<div class="flex flex-wrap items-center justify-between gap-2 bg-gray-800 px-4 py-2 border-b border-gray-700 shrink-0 min-w-0">
			<div class="flex items-center gap-3 min-w-0">
				<span class="text-xs font-mono text-gray-400 truncate">{ data.JobName }</span>
				if data.IsRunning {
					@Tooltip("Live Log Streaming") {
						<span class="relative flex h-2 w-2">
							<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
							<span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
						</span>
					}
				}
			</div>
			if data.Parsed != nil && !data.IsRunning {
				<div data-component="log-search" class="relative flex-1 min-w-[12rem] max-w-md">
					<input
						type="search"
						name="log-search"
						placeholder="Search logs…"
						autocomplete="off"
						spellcheck="false"
						data-role="log-search-input"
						class="block w-full rounded-md border border-gray-700 bg-gray-900 pl-3 pr-20 py-1.5 text-xs font-mono text-gray-200 placeholder-gray-500 focus:border-indigo-500 focus:outline-none"
					/>
					<div class="pointer-events-none absolute inset-y-0 right-0 flex items-center gap-1.5 pr-2">
						<span
							data-role="log-search-count"
							class="hidden text-xs font-mono tabular-nums text-gray-500"
						></span>
						<button
							type="button"
							data-action="log-search-clear"
							aria-label="Clear search"
							class="hidden pointer-events-auto rounded text-gray-400 hover:text-gray-200"
						>
							@IconX("h-4 w-4")
						</button>
						<span data-role="log-search-icon" class="flex items-center gap-1.5 text-gray-500">
							@Kbd("/")
							@IconSearch("h-4 w-4")
						</span>
					</div>
				</div>
			} else {
				<div class="flex-1 min-w-[1rem]"></div>
			}
			<div class="flex items-center gap-1">
				if data.Parsed != nil && !data.IsRunning {
					<div data-component="log-level-filter" class="relative">
						<button
							type="button"
							data-action="toggle-level-filter"
							aria-expanded="false"
							aria-haspopup="listbox"
							class={ btnGhostLabel() }
						>
							@IconFunnel("h-4 w-4")
							<span>Levels</span>
							<span
								data-role="level-count"
								class="text-gray-500 tabular-nums"
							>
								{ strconv.Itoa(len(logLevelOptions())) }/{ strconv.Itoa(len(logLevelOptions())) }
							</span>
							@IconChevronsUpDown("h-4 w-4 text-gray-500")
						</button>
						<div
							data-role="level-menu"
							class={ dropdownMenu() + " bg-gray-800 ring-gray-700" }
							role="listbox"
							aria-multiselectable="true"
						>
							<div class="px-1 pb-1 border-b border-gray-700">
								<label class={ dropdownMenuItem() + " hover:bg-gray-700/50 rounded-md" }>
									<input
										type="checkbox"
										data-level="all"
										checked
										class="log-level-checkbox"
									/>
									<span class="font-mono font-medium text-gray-300">All</span>
								</label>
							</div>
							<div class="px-1 pt-1">
								for _, level := range logLevelOptions() {
									<label class={ dropdownMenuItem() + " hover:bg-gray-700/50 rounded-md" }>
										<input
											type="checkbox"
											data-level={ strconv.Itoa(level.Value) }
											checked
											class="log-level-checkbox"
										/>
										<span class={ "font-mono font-medium " + level.Class }>{ level.Label }</span>
									</label>
								}
							</div>
						</div>
					</div>
				}
				if data.IsRunning {
					@Tooltip("Auto-scroll disabled", "autoscroll") {
						<button
							type="button"
							data-action="toggle-autoscroll"
							aria-label="Toggle auto-scroll"
							class={ btnGhostIcon() }
						>
							<span data-role="autoscroll-icon-on" class="hidden">
								@IconEye("h-4 w-4")
							</span>
							<span data-role="autoscroll-icon-off">
								@IconEyeOff("h-4 w-4")
							</span>
						</button>
					}
				}
				if !data.IsRunning {
					@Tooltip("Download full log [d]") {
						<button
							type="button"
							data-action="download-log"
							data-url={ sanitize.JobLogsDownloadURL(data.Namespace, data.JobName) }
							data-filename={ data.JobName + ".log" }
							aria-label="Download full log"
							class={ btnGhostIcon() }
						>
							@IconDownload("h-4 w-4")
						</button>
					}
				}
				@Tooltip("Close logs [c]") {
					<button
						type="button"
						data-action="close-logs"
						aria-label="Close logs"
						class={ btnGhostIcon() }
					>
						@IconX("h-4 w-4")
					</button>
				}
			</div>
		</div>
		if data.Parsed != nil && data.Message == "" && !data.IsRunning {
			@logSummaryPanel(data.Parsed, data.Platform, data.RepoURL)
		}
		<div
			data-ref="scrollBox"
			id={ "scroll-" + data.JobName }
			class="p-4 overflow-x-auto overflow-y-auto relative flex-1"
		>
			if data.Message != "" {
				@logMessageEmpty(data.Message)
			} else if data.Parsed != nil {
				@logMessageParsed(data.Parsed.Lines)
			} else {
				@logMessageRaw(data.Content)
			}
			if data.Truncated {
				<div
					data-component="log-load-full"
					class="flex flex-col items-center justify-center py-6 gap-2"
				>
					<span class="text-xs font-mono text-gray-500">
						Log truncated to { strconv.FormatInt(data.DisplayTailLines, 10) } lines.
						if data.IsRunning {
							The job is still running.
						}
					</span>
					if !data.IsRunning {
						<button
							type="button"
							data-action="load-full-log"
							hx-get={ sanitize.JobLogsURL(data.Namespace, data.Runner, data.JobName, data.Platform, data.RepoURL, true) }
							hx-target={ "#logs-" + data.JobName }
							hx-swap="outerHTML"
							class={ btnGhostLabel() }
						>
							@IconCloudDownload("h-4 w-4")
							<span>Load full log</span>
						</button>
					}
				</div>
			}
		</div>
	</div>
}

templ logMessageEmpty(message string) {
	<div class="flex flex-col items-center justify-center py-8 text-gray-500 h-full">
		@IconInfo("h-10 w-10 text-gray-600 mb-3")
		<p class="text-sm font-mono text-center px-4">{ message }</p>
	</div>
}

templ logMessageParsed(lines []parser.FormattedLine) {
	<div class="text-xs font-mono whitespace-pre-wrap break-all leading-relaxed text-gray-300">
		for _, line := range lines {
			@logLine(line)
		}
		<div
			data-role="log-search-empty"
			class="hidden flex flex-col items-center justify-center py-8 text-gray-500 h-full"
		>
			<p class="text-sm font-mono text-center px-4">No log entries match your search.</p>
		</div>
	</div>
}

templ logMessageRaw(content string) {
	<pre class="text-xs font-mono text-gray-300 whitespace-pre-wrap break-all leading-relaxed">
		<code>{ content }</code>
	</pre>
}

templ logLine(line parser.FormattedLine) {
	<div
		class="log-line cursor-pointer hover:bg-gray-800/50 px-1 py-1 rounded"
		data-action="toggle-raw"
		data-raw={ line.Raw }
		if line.Level > 0 {
			data-level={ strconv.Itoa(int(line.Level)) }
		}
	>
		<div class="flex items-baseline gap-2">
			if line.Time != "" {
				<span class="text-gray-500 shrink-0 tabular-nums">{ line.Time }</span>
			}
			<span class={ "font-bold shrink-0 w-10 " + line.Class }>{ line.LevelLabel() }</span>
			<span class="text-gray-300 break-all" data-role="log-line-message">{ line.Message }</span>
			@IconChevronRight("log-chevron h-4 w-4 ml-auto shrink-0 self-center text-gray-500 transition-transform")
		</div>
		<div class="hidden log-raw-content mt-1 ml-16 text-gray-500 whitespace-pre-wrap break-all text-xs leading-relaxed">
			<pre class="log-raw-text"></pre>
		</div>
	</div>
}

templ logSummaryPanel(parsed *parser.ParseResult, platform, repoURL string) {
	<div class="bg-gray-800 border-b border-gray-700 px-4 py-3 shrink-0" data-component="log-summary">
		<div class="flex items-center justify-between">
			<div class="flex items-center gap-4">
				if parsed.HasIssues {
					<div class="flex items-center gap-2">
						@IconTriangleAlert("h-4 w-4 text-yellow-400")
						<span class="text-xs font-medium text-yellow-400">
							{ viewmodel.IssueSummaryText(parsed.LogIssues) }
						</span>
					</div>
				} else if parsed.LogIssues != nil {
					<div class="flex items-center gap-2">
						@IconCircleCheck("h-4 w-4 text-green-400")
						<span class="text-xs font-medium text-green-400">No issues</span>
					</div>
				}
				if parsed.PRActivity != nil && viewmodel.HasPRActivity(parsed.PRActivity) {
					if parsed.PRActivity.NeedsApproval > 0 {
						<div class="flex items-center gap-2">
							@IconTriangleAlert("h-4 w-4 text-yellow-400")
							<span class="text-xs font-medium text-yellow-400">{ viewmodel.PRActivitySummary(parsed.PRActivity) }</span>
						</div>
					} else if parsed.PRActivity.Unchanged > 0 && (parsed.PRActivity.Created+parsed.PRActivity.Updated) == parsed.PRActivity.Unchanged {
						<div class="flex items-center gap-2">
							@IconInfo("h-4 w-4 text-gray-400")
							<span class="text-xs font-medium text-gray-400">{ viewmodel.PRActivitySummary(parsed.PRActivity) }</span>
						</div>
					} else if parsed.PRActivity.Created+parsed.PRActivity.Updated > 0 {
						<div class="flex items-center gap-2">
							@IconGitPullRequest("h-4 w-4 text-blue-400")
							<span class="text-xs font-medium text-blue-400">{ viewmodel.PRActivitySummary(parsed.PRActivity) }</span>
						</div>
					}
				}
			</div>
			if (parsed.LogIssues != nil && len(parsed.LogIssues.Issues) > 0) || (parsed.PRActivity != nil && len(parsed.PRActivity.PRs) > 0) {
				<div class="flex items-center gap-1">
					@Tooltip("Toggle details [i]") {
						<button
							type="button"
							data-action="toggle-details"
							class={ btnGhostLabel() }
							aria-expanded="false"
						>
							<span>Details</span>
							<span data-role="details-chevron" class="inline-flex transition-transform">
								@IconChevronRight("h-4 w-4")
							</span>
						</button>
					}
				</div>
			}
		</div>
		if (parsed.LogIssues != nil && len(parsed.LogIssues.Issues) > 0) || (parsed.PRActivity != nil && len(parsed.PRActivity.PRs) > 0) {
			<div class="mt-3 space-y-3 hidden" data-role="details-content">
				if parsed.LogIssues != nil && len(parsed.LogIssues.Issues) > 0 {
					<div>
						<h4 class="text-xs font-semibold text-gray-400 mb-2">Issues</h4>
						<ul class="space-y-1">
							for _, issue := range parsed.LogIssues.Issues {
								<li class="flex items-start gap-2 text-xs">
									if issue.Level >= 50 {
										@IconCircleX("h-4 w-4 text-red-400 mt-0.5 shrink-0")
									} else {
										@IconTriangleAlert("h-4 w-4 text-yellow-400 mt-0.5 shrink-0")
									}
									<span class="text-gray-300">{ issue.Message }</span>
								</li>
							}
							if parsed.LogIssues.Truncated {
								<li class="text-xs text-gray-500 italic">
									... and more (truncated)
								</li>
							}
						</ul>
					</div>
				}
				if parsed.PRActivity != nil && len(parsed.PRActivity.PRs) > 0 {
					<div>
						<h4 class="text-xs font-semibold text-gray-400 mb-2">Pull Requests</h4>
						<ul class="space-y-1">
							for _, pr := range parsed.PRActivity.PRs {
								<li class="flex items-center gap-2 text-xs">
									@prActionIcon(pr.Action)
									if viewmodel.BuildPRURL(platform, repoURL, pr.Number) != "" {
										<a
											href={ viewmodel.BuildPRURL(platform, repoURL, pr.Number) }
											target="_blank"
											rel="noopener noreferrer"
											class="text-gray-300 truncate hover:text-blue-400 hover:underline"
										>{ pr.Title }</a>
									} else {
										<span class="text-gray-300 truncate">{ pr.Title }</span>
									}
									if pr.Number > 0 {
										<span class="text-gray-400">#{ pr.Number }</span>
									}
									<span class="text-gray-400 truncate ml-auto">{ pr.Branch }</span>
								</li>
							}
							if parsed.PRActivity.Truncated {
								<li class="text-xs text-gray-500 italic">
									... and more (truncated)
								</li>
							}
						</ul>
					</div>
				}
			</div>
		}
	</div>
}

templ prActionIcon(action parser.PRAction) {
	switch action {
		case parser.PRActionAutomerged:
			@Tooltip("Automerged") {
				@IconCircleCheck("h-4 w-4 text-green-400 shrink-0")
			}
		case parser.PRActionCreated:
			@Tooltip("Created (new PR)") {
				@IconPlus("h-4 w-4 text-blue-400 shrink-0")
			}
		case parser.PRActionUpdated:
			@Tooltip("Updated") {
				@IconRefreshCw("h-4 w-4 text-yellow-400 shrink-0")
			}
		case parser.PRActionNeedsApproval:
			@Tooltip("Needs approval") {
				@IconTriangleAlert("h-4 w-4 text-orange-400 shrink-0")
			}
		case parser.PRActionUnchanged:
			@Tooltip("Unchanged (no updates needed)") {
				@IconCirclePlus("h-4 w-4 text-gray-400 shrink-0")
			}
	}
}
