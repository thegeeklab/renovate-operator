package view

import (
	"context"
	"html"
	"strings"

	"github.com/thegeeklab/renovate-operator/internal/frontend/i18n"
	"github.com/thegeeklab/renovate-operator/internal/frontend/viewmodel"
)

func avatarInitial(name string) string {
	if name == "" {
		return "?"
	}
	initial := string([]rune(strings.TrimSpace(name))[0:1])
	return html.EscapeString(strings.ToUpper(initial))
}

templ Layout(ctx context.Context, title string, styles []string, scripts []string, auth viewmodel.AuthInfo, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ i18n.FromContext(ctx).Locale() } class="h-full bg-gray-100 dark:bg-gray-900">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="icon" type="image/svg+xml" href="/static/logo.svg" sizes="any"/>
			<script>
				(function(){try{var t=JSON.parse(localStorage.getItem("theme")||"null");if(t==="dark"||(t==="auto"&&window.matchMedia("(prefers-color-scheme: dark)").matches)){document.documentElement.classList.add("dark")}}catch(e){}})();
			</script>
			for _, style := range styles {
				<link rel="stylesheet" href={ style }/>
			}
			for _, script := range scripts {
				<script type="module" src={ script }></script>
			}
			@I18NScript(ctx)
		</head>
		if auth.Enabled && !auth.Authenticated {
			<body class="h-full flex flex-col" hx-boost="true">
				@NavBar(ctx, auth)
				@MainContent(content)
			</body>
		} else {
			<body class="h-full flex flex-col" hx-boost="true" hx-ext="sse" sse-connect="/events">
				@NavBar(ctx, auth)
				@MainContent(content)
			</body>
		}
	</html>
}

templ I18NScript(ctx context.Context) {
	<div id="i18n-data" data-json={ i18n.ClientJSON(i18n.FromContext(ctx).Bundle(), i18n.FromContext(ctx).Locale()) } hidden></div>
}

templ NavBar(ctx context.Context, auth viewmodel.AuthInfo) {
	@NavBarContent(ctx, auth)
}

templ NavBarContent(ctx context.Context, auth viewmodel.AuthInfo) {
	<nav id="navbar" class="bg-gray-800 shrink-0 border-b border-gray-700" hx-preserve="true">
		<div class="w-full px-4 sm:px-6 lg:px-8">
			<div class="flex h-16 items-center justify-between">
				<div class="flex items-center">
					<div class="flex-shrink-0 flex items-center gap-2">
						@Tooltip(i18n.FromContext(ctx).T("layout.go_home") + " [g h]") {
							<a href="/" class="flex items-center gap-4 rounded-md py-1">
								<img src="/static/logo.svg" alt={ i18n.FromContext(ctx).T("layout.logo_alt") } class="h-10 w-10 rounded-md bg-gray-800" loading="eager" decoding="async"/>
								<span class="text-white font-bold text-xl">Renovate Operator</span>
							</a>
						}
					</div>
				</div>
				<div class="flex items-center gap-3">
					<div data-component="theme-switcher" class="flex items-center rounded-md bg-gray-900 p-0.5">
						@Tooltip(i18n.FromContext(ctx).T("layout.light_mode") + " [t]") {
							<button
								type="button"
								data-theme-option="light"
								aria-pressed="false"
								class="rounded p-1.5 text-gray-400 hover:text-gray-200 hover:bg-gray-700/50 transition-colors"
							>
								@IconSun("h-4 w-4")
							</button>
						}
						@Tooltip(i18n.FromContext(ctx).T("layout.auto_mode") + " [t]") {
							<button
								type="button"
								data-theme-option="auto"
								aria-pressed="true"
								class="rounded p-1.5 text-gray-400 hover:text-gray-200 hover:bg-gray-700/50 transition-colors"
								aria-label={ i18n.FromContext(ctx).T("layout.auto_mode") }
							>
								@IconMonitor("h-4 w-4")
							</button>
						}
						@Tooltip(i18n.FromContext(ctx).T("layout.dark_mode") + " [t]") {
							<button
								type="button"
								data-theme-option="dark"
								aria-pressed="false"
								class="rounded p-1.5 text-gray-400 hover:text-gray-200 hover:bg-gray-700/50 transition-colors"
							>
								@IconMoon("h-4 w-4")
							</button>
						}
					</div>
					if auth.Enabled && auth.Authenticated {
						<div class="relative" data-component="avatar-dropdown">
							<button
								type="button"
								data-avatar-button
								class="flex items-center gap-2 rounded-full"
								aria-expanded="false"
								aria-haspopup="true"
							>
								if auth.AvatarURL != "" {
									<div data-component="progressive-image" data-cloak class="relative">
										<img class="h-8 w-8 rounded-full hidden" src={ auth.AvatarURL } alt={ auth.Name }/>
										<div data-fallback class="h-8 w-8 rounded-full bg-gray-600 flex items-center justify-center text-white text-sm font-medium">{ avatarInitial(auth.Name) }</div>
									</div>
								} else {
									<div class="h-8 w-8 rounded-full bg-gray-600 flex items-center justify-center text-white text-sm font-medium">{ avatarInitial(auth.Name) }</div>
								}
							</button>
							<div
								data-avatar-menu
								class={ dropdownMenu() + " bg-white dark:bg-gray-800 w-48 overflow-hidden" }
							>
								<div class="px-4 py-2">
									<p class="text-sm text-gray-900 dark:text-gray-100 font-medium">{ auth.Name }</p>
									<p class="text-xs text-gray-500 dark:text-gray-400 truncate">{ auth.Provider }</p>
								</div>
								<div class="p-1 border-t border-gray-100 dark:border-gray-700">
									<label class="block px-3 py-1">
										<span class="text-xs text-gray-500 dark:text-gray-400 block mb-1">
											{ i18n.FromContext(ctx).T("common.language") }
										</span>
										<select
											data-action="change-locale"
											class="w-full text-xs bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded px-2 py-1 text-gray-700 dark:text-gray-300"
										>
											for _, locale := range i18n.SupportedLocales() {
												if locale == i18n.FromContext(ctx).Locale() {
													<option value={ locale } selected>{ i18n.FromContext(ctx).LanguageName(locale) }</option>
												} else {
													<option value={ locale }>{ i18n.FromContext(ctx).LanguageName(locale) }</option>
												}
											}
										</select>
									</label>
								</div>
								<div class="p-1 border-t border-gray-100 dark:border-gray-700">
									<form method="POST" action="/auth/logout" hx-boost="false">
										<input type="hidden" name="csrf_token" value={ auth.CSRFToken }/>
										<button
											type="submit"
											class={ dropdownMenuItem() + " text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-md" }
										>
											@IconLogOut("h-4 w-4")
											{ i18n.FromContext(ctx).T("common.sign_out") }
										</button>
									</form>
								</div>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	</nav>
}

templ MainContent(content templ.Component) {
	<main class="flex-1 overflow-hidden">
		<div id="dashboard-content" class="h-full w-full" aria-live="polite" aria-atomic="false">
			if content != nil {
				@content
			}
		</div>
	</main>
}
