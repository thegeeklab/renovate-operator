package view

import (
	"context"
	"fmt"
	"time"

	"github.com/thegeeklab/renovate-operator/internal/frontend/i18n"
	"github.com/thegeeklab/renovate-operator/internal/frontend/sanitize"
	"github.com/thegeeklab/renovate-operator/internal/frontend/viewmodel"
)

func getRepoClass(status viewmodel.Status) string {
	return statusCardBase() + " px-4 py-3 " + status.LeftBorderClass()
}

templ GitRepoPRBadge(ctx context.Context, openPRs, needsApproval, unchangedPRs int) {
	if openPRs > 0 {
		@Tooltip(getPRBadgeTooltip(ctx, true, openPRs, needsApproval, unchangedPRs)) {
			<span class={ "inline-flex items-center gap-1 rounded-full px-2 py-1 text-xs font-medium ring-1 ring-inset " + getPRBadgeColorClasses(openPRs, needsApproval, unchangedPRs) }>
				@IconGitPullRequest("h-3.5 w-3.5")
				{ openPRs }
			</span>
		}
	}
}

templ GitRepoWarningsBadge(ctx context.Context, warnCount, errorCount int) {
	if warnCount > 0 || errorCount > 0 {
		@Tooltip(getWarningsBadgeTooltip(ctx, warnCount, errorCount)) {
			<span class={ "inline-flex items-center gap-1 rounded-full px-2 py-1 text-xs font-medium ring-1 ring-inset " + getWarningBadgeColorClasses(errorCount) }>
				@IconTriangleAlert("h-3.5 w-3.5")
				@WarningCountDisplay(warnCount, errorCount)
			</span>
		}
	}
}

templ GitRepoList(ctx context.Context, repos []viewmodel.GitRepoInfo) {
	if len(repos) > 0 {
		<ul data-kb-nav-scope="repo-list" class="grid grid-cols-1 gap-4" role="list">
			for _, r := range repos {
				<li>
					<a
						data-kb-nav
						href={ sanitize.GitrepoURL(r.Namespace, r.Name) }
						hx-get={ sanitize.GitrepoURL(r.Namespace, r.Name) }
						hx-push-url="true"
						hx-target="#dashboard-content"
						hx-swap="innerHTML"
						hx-params="not sort,order"
						aria-label={ fmt.Sprintf("View repository %s in namespace %s", r.Name, r.Namespace) }
						class={ getRepoClass(r.LastRenovateStatus) }
					>
						<div class="min-w-0 flex-1">
							<p class="text-sm font-medium text-gray-900 dark:text-gray-100 truncate">{ r.FullName }</p>
							<p class="mt-1 flex items-center gap-3 text-xs text-gray-500 dark:text-gray-400">
								@Tooltip(r.CreatedAt.Format("Jan 02, 2006 15:04")) {
									<span>
										{ viewmodel.GitRepoFieldCreated.TranslatedLabel(ctx) + ": " }<span data-timestamp={ r.CreatedAt.UTC().Format(time.RFC3339) } data-format="relative">{ r.CreatedAt.UTC().Format("2006-01-02T15:04:05Z") }</span>
									</span>
								}
								if !r.LastRenovateAt.IsZero() {
									@Tooltip(r.LastRenovateAt.Format("Jan 02, 2006 15:04")) {
										<span>
											{ viewmodel.GitRepoFieldLastRun.TranslatedLabel(ctx) + ": " }<span data-timestamp={ r.LastRenovateAt.UTC().Format(time.RFC3339) } data-format="relative">{ r.LastRenovateAt.UTC().Format("2006-01-02T15:04:05Z") }</span>
										</span>
									}
								}
							</p>
						</div>
						<div class="flex-shrink-0 flex items-center gap-6">
							<div class="flex items-center gap-2">
								@GitRepoPRBadge(ctx, r.OpenPRs, r.NeedsApproval, r.UnchangedPRs)
								@GitRepoWarningsBadge(ctx, r.WarnCount, r.ErrorCount)
							</div>
							@statusBadge(ctx, r.LastRenovateStatus)
						</div>
					</a>
				</li>
			}
		</ul>
	} else {
		@EmptyState(i18n.FromContext(ctx).T("gitrepo.no_repos_title"), i18n.FromContext(ctx).T("gitrepo.no_repos_message"), "py-6")
	}
}
